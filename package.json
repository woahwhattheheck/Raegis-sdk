{
  "name": "@aegis/sdk",
  "version": "0.1.0",
  "description": "The official TypeScript SDK for the Aegis RWA Protocol on Soroban.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:smoke": "node scripts/package-smoke.mjs",
    "test:compat": "node scripts/check-compat.mjs",
    "check": "npm run build && npm run test:smoke && npm test -- --runInBand && npm run test:compat",
    "verify": "npm run lint && npm run format && npm run build && npm run test:smoke && npm test -- --runInBand && npm run test:compat",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AegisRWA/aegis-sdk.git"
  },
  "keywords": [
    "stellar",
    "soroban",
    "rwa",
    "web3",
    "sdk"
  ],
  "author": "Aegis RWA Protocol",
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.1",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}
